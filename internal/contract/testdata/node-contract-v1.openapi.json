{
  "openapi": "3.1.0",
  "info": {
    "title": "DEN portal: contract with the instant-APIs kit",
    "version": "1",
    "description": "API of the DEN portal. Errors use RFC 9457 problem details (application/problem+json)."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/nodes/{nodeId}/config": {
      "get": {
        "operationId": "getNodeConfig",
        "summary": "What the network expects from the node",
        "tags": [
          "node contract"
        ],
        "parameters": [
          {
            "name": "nodeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The configuration",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contractVersion": {
                      "type": "string",
                      "const": "1"
                    },
                    "nodeId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "heartbeatIntervalSeconds": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "minimumKitVersion": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "services": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "apiVersionId": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "apiName": {
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          },
                          "basePath": {
                            "type": "string"
                          },
                          "servicePath": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "apiVersionId",
                          "apiName",
                          "version",
                          "basePath",
                          "servicePath"
                        ]
                      }
                    },
                    "notices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "code",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "contractVersion",
                    "nodeId",
                    "heartbeatIntervalSeconds",
                    "minimumKitVersion",
                    "services",
                    "notices"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "nodeMutualTls": []
          }
        ]
      }
    },
    "/api/v1/nodes/{nodeId}/heartbeat": {
      "post": {
        "operationId": "nodeHeartbeat",
        "summary": "Heartbeat of a node: version, services it exposes and health",
        "description": "Every heartbeatIntervalSeconds. Five minutes without one and the node goes offline.",
        "tags": [
          "node contract"
        ],
        "parameters": [
          {
            "name": "nodeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kitVersion": {
                    "type": "string",
                    "maxLength": 40,
                    "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
                  },
                  "servicePort": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "services": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80,
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        },
                        "path": {
                          "type": "string",
                          "maxLength": 200,
                          "pattern": "^\\/[A-Za-z0-9._~\\-/]*$"
                        },
                        "openapiSha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "name",
                        "path"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "health": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": [
                          "ok",
                          "degraded",
                          "failing"
                        ]
                      },
                      "detail": {
                        "type": "string",
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "status"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "kitVersion",
                  "servicePort",
                  "services",
                  "health"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "enrollment_issued",
                        "enrolled",
                        "online",
                        "offline",
                        "decommissioned"
                      ]
                    },
                    "nextHeartbeatSeconds": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "renewCertificate": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "status",
                    "nextHeartbeatSeconds",
                    "renewCertificate"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "nodeMutualTls": []
          }
        ]
      }
    },
    "/api/v1/nodes/{nodeId}/renew": {
      "post": {
        "operationId": "renewNodeCertificate",
        "summary": "Renew the certificate of a node for a new key",
        "tags": [
          "node contract"
        ],
        "parameters": [
          {
            "name": "nodeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "csr": {
                    "type": "string",
                    "minLength": 100,
                    "maxLength": 10000
                  }
                },
                "required": [
                  "csr"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The new certificate",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "certificate": {
                      "type": "string"
                    },
                    "certificateNotAfter": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "previousValidUntil": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "certificate",
                    "certificateNotAfter",
                    "previousValidUntil"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "nodeMutualTls": []
          }
        ]
      }
    },
    "/api/v1/nodes/enroll": {
      "post": {
        "operationId": "enrollNode",
        "summary": "Enroll a kit node with its single-use token",
        "description": "The kit sends its token, a CSR (CN=den-node, no other names) and its WireGuard public key. It receives its certificate (DNS name den-node-<nodeId>), the network root, its tunnel configuration and where the control channel is. The token stops working.",
        "tags": [
          "node contract"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 200
                  },
                  "csr": {
                    "type": "string",
                    "minLength": 100,
                    "maxLength": 10000
                  },
                  "wireguardPublicKey": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
                  },
                  "kitVersion": {
                    "type": "string",
                    "maxLength": 40,
                    "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
                  },
                  "servicePort": {
                    "default": 8443,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "required": [
                  "token",
                  "csr",
                  "wireguardPublicKey",
                  "kitVersion"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The node is enrolled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contractVersion": {
                      "type": "string",
                      "const": "1"
                    },
                    "nodeId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "nodeName": {
                      "type": "string"
                    },
                    "certificate": {
                      "type": "string"
                    },
                    "certificateNotAfter": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "caCertificate": {
                      "type": "string"
                    },
                    "controlUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "gatewayClientName": {
                      "type": "string"
                    },
                    "heartbeatIntervalSeconds": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "wireguard": {
                      "type": "object",
                      "properties": {
                        "address": {
                          "type": "string"
                        },
                        "hubPublicKey": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
                        },
                        "hubEndpoint": {
                          "type": "string"
                        },
                        "hubAddress": {
                          "type": "string"
                        },
                        "allowedIps": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "persistentKeepaliveSeconds": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "address",
                        "hubPublicKey",
                        "hubEndpoint",
                        "hubAddress",
                        "allowedIps",
                        "persistentKeepaliveSeconds"
                      ]
                    }
                  },
                  "required": [
                    "contractVersion",
                    "nodeId",
                    "nodeName",
                    "certificate",
                    "certificateNotAfter",
                    "caCertificate",
                    "controlUrl",
                    "gatewayClientName",
                    "heartbeatIntervalSeconds",
                    "wireguard"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "citizenBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token of the national digital identity, issued to an authorized citizen app (the Carpeta Ciudadana). Development: realm den-citizens."
      },
      "nodeMutualTls": {
        "type": "mutualTLS",
        "description": "Control channel of kit nodes (ARCHITECTURE.md §10): TLS with the node certificate issued at enrollment, at the gateway (DEN_NODE_CONTROL_URL), which passes the verified thumbprint to the portal."
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "validation_failed",
              "bad_request",
              "unauthenticated",
              "forbidden",
              "not_found",
              "conflict",
              "gone",
              "invalid_transition",
              "payload_too_large",
              "unsupported_media_type",
              "rate_limited",
              "internal",
              "service_unavailable",
              "mfa_required"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      }
    }
  }
}
