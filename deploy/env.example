# /opt/rid-node/.env (written by install.sh). No secrets here.
RID_NODE_IMAGE=rid-node
RID_NODE_VERSION=0.1.0
# -canal: secure channel only (entities with their own APIs); empty: completo
RID_NODE_TAG_SUFFIX=-canal
# Corporate proxy toward the portal and the gateway (optional). WireGuard (UDP 51820) cannot use it.
HTTPS_PROXY=
NO_PROXY=
