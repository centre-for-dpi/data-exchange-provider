-- Integration data, PostgreSQL (synthetic, deterministic; the same in every engine).
CREATE SCHEMA salud;
CREATE TABLE salud.personas_base (
  persona_id       integer PRIMARY KEY,
  tipo_documento   varchar(3)   NOT NULL,
  numero_documento varchar(20)  NOT NULL UNIQUE,
  nombres          varchar(80)  NOT NULL,
  eps              varchar(60)  NOT NULL,
  regimen          varchar(20)  NOT NULL,
  estado           varchar(20)  NOT NULL,
  fecha_afiliacion date         NOT NULL,
  actualizado_en   timestamptz  NOT NULL,
  puntaje          numeric(6,2) NOT NULL,
  activo           boolean      NOT NULL,
  hogar_id         integer      NOT NULL
);
INSERT INTO salud.personas_base
SELECT i,
       CASE WHEN i % 10 = 0 THEN 'CE' ELSE 'CC' END,
       (1000000000 + i)::text,
       'Persona sintética ' || i,
       (ARRAY['EPS Uno','EPS Dos','EPS Tres','EPS Cuatro','EPS Cinco'])[i % 5 + 1],
       CASE WHEN i % 2 = 0 THEN 'contributivo' ELSE 'subsidiado' END,
       CASE WHEN i % 7 = 0 THEN 'retirado' ELSE 'activo' END,
       DATE '2026-01-01' - ((i * 37) % 3650),
       TIMESTAMPTZ '2026-11-01 08:00:00-05' + i * INTERVAL '1 minute',
       ((i * 13) % 10000)::numeric / 100,
       i % 7 <> 0,
       (i + 1) / 2
FROM generate_series(1, 1000) AS i;

CREATE VIEW salud.v_afiliados AS
SELECT tipo_documento, numero_documento, eps, regimen, estado, fecha_afiliacion, actualizado_en
FROM salud.personas_base;
CREATE VIEW salud.v_hogares AS
SELECT hogar_id, numero_documento, puntaje, activo FROM salud.personas_base;
CREATE TABLE salud.notas_internas (id integer PRIMARY KEY, nota varchar(200));

-- Odd types and large values (Review Focus 5). Row 2 is all NULL.
CREATE TABLE salud.tipos (
  id              integer PRIMARY KEY,
  decimal_largo   numeric(38,10),
  entero_grande   bigint,
  fecha           date,
  fecha_hora      timestamp(3),
  fecha_hora_zona timestamptz(3),
  texto           varchar(100),
  bandera         boolean,
  identificador   uuid,
  binario         bytea
);
INSERT INTO salud.tipos VALUES
  (1, 12345678901234567890.1234567890, 9007199254740993, DATE '2026-11-16', TIMESTAMP '2026-11-16 10:30:15.123',
   TIMESTAMPTZ '2026-11-16 10:30:15.123-05', E'José "Pepe" O''Brien\nñandú ✓', true,
   '6f1c0b2a-3d4e-4f50-8a6b-7c8d9e0f1a2b', '\x00ff'),
  (2, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
CREATE VIEW salud.v_tipos AS SELECT * FROM salud.tipos;

-- A fixed-width key (CHAR), as legacy schemas keep document numbers.
CREATE TABLE salud.codigos (codigo char(10) PRIMARY KEY, nombre varchar(50));
INSERT INTO salud.codigos VALUES ('ABC', 'Uno');
CREATE VIEW salud.v_codigos AS SELECT * FROM salud.codigos;

-- Keys in upper case, with a space, and NULL (Review Focus 3).
CREATE TABLE salud.claves (clave varchar(20), nombre varchar(50));
INSERT INTO salud.claves VALUES ('ABC-1', 'mayusculas'), ('con espacio', 'espacio'), (NULL, 'nulo');
CREATE VIEW salud.v_claves AS SELECT * FROM salud.claves;

-- Two long decimal keys that differ in the last digit (MySQL compares DECIMAL with a string
-- as a double: the node must compare them exactly).
CREATE TABLE salud.decimales (id numeric(25,0) PRIMARY KEY, nombre varchar(20));
INSERT INTO salud.decimales VALUES (12345678901234567890, 'uno'), (12345678901234567891, 'dos');
CREATE VIEW salud.v_decimales AS SELECT * FROM salud.decimales;

-- A table someone can write to, for the read-only checks.
CREATE TABLE salud.escritura (id integer PRIMARY KEY, nota varchar(100));

CREATE ROLE den_reader LOGIN PASSWORD :'reader_pw';
GRANT USAGE ON SCHEMA salud TO den_reader;
GRANT SELECT ON salud.v_afiliados, salud.v_hogares, salud.v_tipos, salud.v_codigos, salud.v_claves, salud.v_decimales TO den_reader;

CREATE ROLE den_writer LOGIN PASSWORD :'writer_pw';
GRANT USAGE ON SCHEMA salud TO den_writer;
GRANT SELECT, INSERT, UPDATE, DELETE ON salud.escritura TO den_writer;

-- Writes through a column-level grant only.
CREATE ROLE den_column_writer LOGIN PASSWORD :'writer_pw';
GRANT USAGE ON SCHEMA salud TO den_column_writer;
GRANT SELECT, UPDATE (nota) ON salud.escritura TO den_column_writer;
