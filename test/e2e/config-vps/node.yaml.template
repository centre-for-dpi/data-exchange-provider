# Template of node.yaml for the end-to-end test against a deployed portal (DEN_E2E_TARGET=vps), as an entity
# would run it: public portal, public gateway and hub over the internet; the entity's own API
# is the portal's test provider running next to the node.
portal: @PORTAL@ # written by canal-e2e.mjs from DEN_API_URL into node.yaml
services:
  - name: afiliacion
    path: /salud
    type: proxy
    upstream: http://api-propia:8000
    allowPlainHttp: true
    openapi: /etc/den-node/salud.openapi.yaml # copied from the portal by canal-e2e.mjs
